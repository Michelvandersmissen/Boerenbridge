rules_version = '2';

// Anonieme login: elk apparaat krijgt een eigen uid. Een spel hoort bij de
// uid die het aanmaakte (ownerId). Je kunt alleen je eigen spellen lezen,
// wijzigen en verwijderen.
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameId} {
      allow read, delete: if isEigenaar(resource.data);

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && isGeldigSpel(request.resource.data);

      allow update: if isEigenaar(resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && isGeldigSpel(request.resource.data);
    }

    function isEigenaar(data) {
      return request.auth != null && data.ownerId == request.auth.uid;
    }

    function isGeldigSpel(data) {
      return data.naam is string
        && data.naam.size() <= 80
        && data.ownerId is string
        && data.players is list
        && data.players.size() >= 3
        && data.players.size() <= 8
        && data.rounds is list
        && data.kaartenReeks is list
        && data.updatedAt is number
        && data.status in ['setup', 'spelen', 'klaar'];
    }
  }
}
