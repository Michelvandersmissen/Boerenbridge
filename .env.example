# Firebase web-app config. Kopieer dit bestand naar .env en vul je eigen waarden in.
# Vind deze in de Firebase console: Project settings > Your apps > Web app > SDK setup.
# Let op: deze waarden zijn niet geheim (ze staan in de client), maar .env blijft buiten git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
